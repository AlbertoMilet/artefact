# Copie para .env e preencha. O .env não vai para o git.

# Provedor do LLM: "openrouter" (real) ou "fake" (roteirizado, sem chave, para testes e demonstração)
LLM_PROVIDER=openrouter

# Chave em https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Modelo escolhido na Fase 0 (docs/fase0-modelos.md). Toda chamada exige Zero Data Retention.
OPENROUTER_MODEL=anthropic/claude-haiku-5.5

# Opcionais
# EMPORIO_DATA_DIR=data
# DATA_REFERENCIA=2026-03-25T10:00:00-04:00
# MAX_TOOL_CALLS=5
# TURN_TIMEOUT_S=30
# HISTORY_WINDOW=10
