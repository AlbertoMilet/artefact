# Copie para .env e preencha. O .env n√£o vai para o git.

# Provedor do LLM: "openrouter" (real) ou "fake" (roteirizado, sem chave, para testes e demonstra√ß√£o)
LLM_PROVIDER=openrouter

# Chave em https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Modelo escolhido na Fase 0 (docs/fase0-modelos.md, decis√£o D-10). Toda chamada exige Zero Data Retention.
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash

# Opcionais
# EMPORIO_DATA_DIR=data
# DATA_REFERENCIA=2026-03-25T10:00:00-04:00
# MAX_TOOL_CALLS=5
# TURN_TIMEOUT_S=30
# HISTORY_WINDOW=10

