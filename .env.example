# Copie para .env e preencha. O .env não vai para o git.

# Provedor do LLM: "openrouter" (real) ou "fake" (roteirizado, sem chave, para testes e demonstração)
LLM_PROVIDER=openrouter

# Chave em https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Modelo escolhido na Fase 0 (docs/fase0-modelos.md, decisão D-10). Toda chamada exige Zero Data Retention.
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash

# Opcionais
# EMPORIO_DATA_DIR=data
# DATA_REFERENCIA=2026-03-25T10:00:00-04:00
# MAX_TOOL_CALLS=5
# TURN_TIMEOUT_S=30
# HISTORY_WINDOW=10

# Retenção por inatividade na janela de 24 h (SPEC-002). Desligada por padrão.
# RETENCAO_ATIVA=false
# RETENCAO_AVALIACOES_MIN=30,240,1260
# RETENCAO_MAX_LEMBRETES=3
# RETENCAO_MAX_AVALIACOES=6
# RETENCAO_INTERVALO_MIN=20
# RETENCAO_ULTIMA_TENTATIVA_H=4
# RETENCAO_MARGEM_ENVIO_MIN=30

# Conexão do WhatsApp da loja (SPEC-004): app da Meta com WhatsApp e Facebook Login
# META_APP_ID=
# META_APP_SECRET=
# META_REDIRECT_URI=http://localhost:8765/callback
# META_GRAPH_VERSION=v25.0
# Conta do WhatsApp Business, se o login não a informar
# META_WABA_ID=
# Chave Fernet para guardar o token cifrado: python -m emporio whatsapp gerar-chave
# WHATSAPP_CHAVE_CIFRA=

# Som dos alertas também no chat (o vigia `python -m emporio vendedor` sempre toca)
# ALERTA_SOM_NO_CHAT=false
